# Never commit real values. Use a separate database and bot for Hunter3.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/hunter3
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
MINI_APP_URL=https://hunter3-frontend.example.com
MINI_APP_ORIGINS=https://hunter3-frontend.example.com
VITE_API_BASE_URL=https://hunter3-api.example.com

# Local browser development only. Never enable this in production.
LOCAL_DEV_AUTH_BYPASS=0
LOCAL_DEV_USER_ID=local-dev-user
